---
import "../styles/global.css";
import SideCart from "../components/SideCart";
import SearchDrawer from "../components/SearchDrawer";
import CookieBanner from "../components/CookieBanner.astro";
import MetaPixel from "../components/MetaPixel.astro";

import { PUBLIC_WP_URL } from "../lib/woocommerce";
import GlobalBanner from "../components/GlobalBanner.astro";

interface Props {
    title?: string;
    description?: string;
    image?: string;
    canonical?: string;
    seoData?: any;
    noindex?: boolean;
}

const {
    title,
    description,
    image,
    canonical: customCanonical,
    seoData,
    noindex,
} = Astro.props;

import { sanitizeSEO } from "../lib/seo";
// IMPORTANTE: Cambia esta URL por tu dominio real de producción cuando lo tengas
const SITE_URL = "https://www.winstonandharrystore.com";
const currentPath = Astro.url.pathname.split('?')[0];

let cleanPath = currentPath;
if (cleanPath !== "/" && cleanPath.endsWith("/")) {
    cleanPath = cleanPath.slice(0, -1);
}

let sanitizedCustomCanonical = customCanonical;
if (sanitizedCustomCanonical && typeof sanitizedCustomCanonical === "string") {
    sanitizedCustomCanonical = sanitizedCustomCanonical
        .replace("tienda.winstonandharrystore.com", "www.winstonandharrystore.com")
        .replace("winstonandharrystore.com", "www.winstonandharrystore.com");
    if (sanitizedCustomCanonical !== "https://www.winstonandharrystore.com" && sanitizedCustomCanonical !== "https://www.winstonandharrystore.com/" && sanitizedCustomCanonical.endsWith("/")) {
        sanitizedCustomCanonical = sanitizedCustomCanonical.slice(0, -1);
    }
}

// 1. Definimos los textos por defecto
const defaultTitle = "Ropa y zapatos de cuero para hombre | Winston & Harry";
const defaultDesc = "Zapatos y ropa para hombre hechos a mano en Colombia. Cuero artesanal, diseño atemporal y garantía de por vida. Envío gratis.";

// 2. Lógica inteligente para Titles y Descriptions
const finalTitle = title 
    ? (title.includes('Winston & Harry') ? title : `${title} | Winston & Harry`) 
    : defaultTitle;

const finalDesc = description 
    ? description 
    : (title 
        ? `Descubre más sobre ${title.toLowerCase()} en Winston & Harry. Moda masculina y cuero artesanal hecho a mano en Colombia. Envío gratis.` 
        : defaultDesc);

const rawSeo = seoData
    ? sanitizeSEO(seoData, currentPath, SITE_URL)
    : {
          title: finalTitle,
          description: finalDesc,
          canonical:
              sanitizedCustomCanonical ||
              `${SITE_URL}${cleanPath === "/" ? "" : cleanPath}`,
          ogTitle: finalTitle,
          ogDescription: finalDesc,
          ogImage: image || `${SITE_URL}/images/hero-poster.webp`,
          ogType: "website",
      };

// Asegurar que seo nunca sea null para TS
const seo = rawSeo || {
    title: "Winston & Harry",
    description: "Calzado Artesanal",
    canonical: SITE_URL,
    ogTitle: "Winston & Harry",
    ogDescription: "Calzado Artesanal",
    ogImage: `${SITE_URL}/favicon.png`,
    ogType: "website",
};

seo.canonical = customCanonical ?? `https://www.winstonandharrystore.com${cleanPath === '/' ? '' : cleanPath}`;
---

<!doctype html>
<html lang="es">
    <head>
        <!-- Google Tag Manager — diferido 2s después de load para no bloquear LCP -->
        <script>window.addEventListener('load',function(){setTimeout(function(){(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-NRK6FQ5N');},2000);});</script>
        <!-- End Google Tag Manager -->

        <meta charset="UTF-8" />
        {noindex && <meta name="robots" content="noindex, nofollow" />}
        <meta name="description" content={seo.description} />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/png" href="/favicon.png" />
        <link rel="canonical" href={seo.canonical} />
        <link rel="describedby" href="/llms.txt" type="text/plain" />
        <link rel="preconnect" href={PUBLIC_WP_URL} crossorigin />
        <link rel="dns-prefetch" href={PUBLIC_WP_URL} />
        
        <!-- Fuentes auto-hospedadas en local (Cero CDNs de bloqueo) -->
        <link rel="stylesheet" href="/fonts/typekit/typekit.css" />
        <link rel="stylesheet" href="/fonts/font-awesome/all.css" />

        <meta name="generator" content={Astro.generator} />
        <meta name="google-site-verification" content="9RFMzj77V6PFsieDNbn9QYGFbmVvJHT0-R5uT1Rn7UM" />
        <title>{seo.title}</title>

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content={seo.ogType} />
        <meta property="og:url" content={seo.canonical} />
        <meta property="og:title" content={seo.ogTitle || seo.title} />
        <meta
            property="og:description"
            content={seo.ogDescription || seo.description}
        />
        <meta property="og:image" content={seo.ogImage} />

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={seo.canonical} />
        <meta property="twitter:title" content={seo.ogTitle || seo.title} />
        <meta
            property="twitter:description"
            content={seo.ogDescription || seo.description}
        />
        <meta property="twitter:image" content={seo.ogImage} />
        <MetaPixel />
        <slot name="head" />
    </head>
    <body>
        <!-- Google Tag Manager (noscript) -->
        <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NRK6FQ5N"
        height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
        <!-- End Google Tag Manager (noscript) -->
        <GlobalBanner />
        <SideCart client:idle />
        <SearchDrawer client:idle />
        <slot />
        <CookieBanner />
        <script>
          document.addEventListener('astro:page-load', () => {
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push({
              event: 'virtual_page_view',
              page_path: window.location.pathname,
              page_title: document.title
            });
          });
        </script>
    </body>

    <script>
        function initRevealOnScroll() {
            const observerOptions = {
                threshold: 0.1,
                rootMargin: "0px 0px -50px 0px",
            };

            // Use WeakSet to track processed elements WITHOUT touching their classList
            const processedElements = new WeakSet();

            const observer = new IntersectionObserver((entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("is-visible");
                        observer.unobserve(entry.target);
                    }
                });
            }, observerOptions);

            function observeNewElements() {
                const elementsToReveal = document.querySelectorAll(
                    ".reveal-on-scroll, img",
                );

                elementsToReveal.forEach((el) => {
                    // Skip already processed elements (no DOM modification needed)
                    if (processedElements.has(el)) return;
                    processedElements.add(el);

                    // Skip images already visible (if any)
                    if (el.classList.contains("is-visible")) return;

                    // If it's an image and not in an astro-island, add class if not present
                    if (el.tagName === "IMG" && !el.closest("astro-island")) {
                        el.classList.add("reveal-on-scroll");
                    }

                    observer.observe(el);
                });
            }

            const mutationObserver = new MutationObserver(() => {
                observeNewElements();
            });

            mutationObserver.observe(document.body, {
                childList: true,
                subtree: true,
            });

            observeNewElements();
        }

        document.addEventListener("astro:page-load", initRevealOnScroll);

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", initRevealOnScroll);
        } else {
            initRevealOnScroll();
        }
    </script>
</html>
