---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ProductDetail from "../../components/ProductDetail";
import { getProductBySlug, getProductsPool, getAllProducts, wcFetch } from "../../lib/woocommerce";
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
    const fs = await import('node:fs');
    const path = await import('node:path');
    
    // Directorio de salida para detalles de producto
    const productsDir = path.join(process.cwd(), 'public', 'data', 'products');
    if (!fs.existsSync(productsDir)) {
        fs.mkdirSync(productsDir, { recursive: true });
    }

    let allProducts: any[] = [];
    let page = 1;
    let hasMore = true;

    console.log("[SSG Total] Obteniendo lista de todos los productos para getStaticPaths...");

    while (hasMore) {
        try {
            // Obtenemos los productos de la API usando getAllProducts
            const products = await getAllProducts(100, page);
            if (Array.isArray(products) && products.length > 0) {
                allProducts = [...allProducts, ...products];
                page++;
            } else {
                hasMore = false;
            }
        } catch (e: any) {
            console.error(`[getStaticPaths - Productos] Error en página ${page}:`, e.message);
            hasMore = false;
        }
        
        // Límite de seguridad
        if (page > 15) break;
    }

    console.log(`[SSG Total] Encontrados ${allProducts.length} productos. Pre-generando JSONs de variaciones y detalles...`);

    // Inyección forzada del producto de prueba para que siempre tenga URL generada
    // incluso si en WooCommerce lo marcan como "Oculto" (Visibilidad de catálogo: Oculto)
    if (!allProducts.some(p => p.slug === 'test')) {
        allProducts.push({ slug: 'test' });
    }

    // 2. Pre-generar los archivos JSON de detalle para cada producto (CON CONCURRENCIA CONTROLADA A 5 EN PARALELO Y DESCANSO DE 200ms)
    const CONCURRENCY = 5;
    const chunks: any[][] = [];
    for (let i = 0; i < allProducts.length; i += CONCURRENCY) {
        chunks.push(allProducts.slice(i, i + CONCURRENCY));
    }

    console.log(`[SSG Total] Iniciando pre-generación en ${chunks.length} lotes de ${CONCURRENCY} productos en paralelo...`);

    let completedCount = 0;
    for (const chunk of chunks) {
        await Promise.all(chunk.map(async (p) => {
            if (!p.slug) return;
            try {
                const filePath = path.join(productsDir, `${p.slug}.json`);
                // En DEV, si el archivo ya existe saltamos la descarga para no bloquear el servidor
                if (import.meta.env.DEV && fs.existsSync(filePath)) {
                    return;
                }

                // Obtenemos el producto completo (con variaciones y WPC media)
                const fullProduct = await getProductBySlug(p.slug);
                if (fullProduct) {
                    const filePath = path.join(productsDir, `${p.slug}.json`);
                    fs.writeFileSync(filePath, JSON.stringify(fullProduct, null, 2), 'utf-8');
                }
            } catch (err: any) {
                console.error(`[SSG Total] Error guardando JSON para producto ${p.slug}:`, err.message);
            }
        }));
        completedCount += chunk.length;
        console.log(`[SSG Total] Progreso: ${completedCount}/${allProducts.length} productos procesados.`);
        // Descanso de 200ms entre bloques para dar respiro al servidor
        await new Promise(r => setTimeout(r, 200));
    }

    console.log("[SSG Total] ✓ JSONs de productos pre-generados exitosamente.");

    return allProducts.filter(p => p.slug).map(p => ({
        params: { slug: p.slug }
    }));
}

const { slug } = Astro.params;

let product: any = null;
let error: any = null;

try {
    // 1. Cargar el producto desde el JSON pre-generado localmente para evitar llamadas repetidas a la red durante el renderizado
    const jsonPath = path.join(process.cwd(), 'public', 'data', 'products', `${slug}.json`);
    if (fs.existsSync(jsonPath)) {
        product = JSON.parse(fs.readFileSync(jsonPath, 'utf-8'));
    } else {
        // Fallback dinámico si no existe el archivo (p. ej. en desarrollo)
        product = await getProductBySlug(slug as string);
    }
    
    if (product) {
        // --- FETCH RELATED PRODUCTS & FBT ---
        let relatedProducts: any[] = [];
        let fbtProducts: any[] = [];
        
        try {
            // IDs de categorías actualizados según el catálogo actual de W&H
            const shoeCats = [63, 194, 192, 195, 193, 196, 70]; 
            const clothingCats = [249, 951, 952, 251, 1022, 250];        
            const accessoryCats = [126, 172, 190];             
            
            // Usamos el pool de productos con caché de 10 minutos (Optimizado)
            // Usamos el pool de productos con caché de 10 minutos (Optimizado)
            const rawProducts = await getProductsPool();
            
            if (rawProducts && rawProducts.length > 0) {
                // Usamos directamente los productos del pool, ya están mapeados por getProductsPool
                const allStoreProducts = rawProducts;
                
                const currentCats = product.categories?.map((c: any) => c.id) || [];
                const pName = (product.name || "").toLowerCase();
                
                const isCurrentShoe = currentCats.some((id: any) => shoeCats.includes(id)) || 
                                      pName.includes('zapato') || pName.includes('mocasín') || pName.includes('tenis') || pName.includes('bota');
                
                const isCurrentClothing = currentCats.some((id: any) => clothingCats.includes(id)) || 
                                          pName.includes('chaqueta') || pName.includes('sueter') || pName.includes('suéter') || pName.includes('camisa') || pName.includes('pantalon');

                // 1. Completa tu look (Preferimos relacionados definidos en WC, si no, aleatorios)
                const wcRelatedIds = [...(product.upsell_ids || []), ...(product.related_ids || [])];
                
                if (wcRelatedIds.length > 0) {
                    relatedProducts = allStoreProducts.filter((p: any) => wcRelatedIds.includes(p.id)).slice(0, 4);
                }
                
                if (relatedProducts.length < 4) {
                    const extra = allStoreProducts
                        .filter((p: any) => p.id !== product.id && !relatedProducts.some(rp => rp.id === p.id))
                        .sort(() => Math.random() - 0.5)
                        .slice(0, 4 - relatedProducts.length);
                    relatedProducts = [...relatedProducts, ...extra];
                }

                // 2. El Complemento Ideal (FBT)
                // Si es zapato, sugerimos ropa. Si es ropa, sugerimos zapatos.
                let poolA = allStoreProducts.filter((p: any) => p.id !== product.id && (p.categories?.some((c: any) => shoeCats.includes(c.id))));
                let poolB = allStoreProducts.filter((p: any) => p.id !== product.id && (p.categories?.some((c: any) => clothingCats.includes(c.id))));
                
                if (isCurrentShoe) {
                   fbtProducts = poolB.length > 0 ? [poolB[0]] : [allStoreProducts.find((p: any) => p.id !== product.id)];
                } else {
                   fbtProducts = poolA.length > 0 ? [poolA[0]] : [allStoreProducts.find((p: any) => p.id !== product.id)];
                }
            }
        } catch (e) {
            console.error("Error fetching related products:", e);
        }

        product.fbt_products = fbtProducts.filter(Boolean);

    } else {
        error = "Producto no encontrado en el catálogo";
    }
} catch (e) {
    console.error("Error crítico en [slug].astro:", e);
    error = "Hubo un problema de conexión.";
}
if (!product && !error) {
    return Astro.redirect("/404");
}

// SEO Bridge: Conexión dinámica con metadatos de RankMath / Yoast / WooCommerce
// El fallback mejora el CTR cuando WP no tiene título SEO configurado manualmente

// RankMath guarda sus datos en el array meta_data de WooCommerce (no como objeto top-level)
const rankMathTitle = product?.meta_data?.find((m: any) => m.key === 'rank_math_title')?.value || '';
const rankMathDesc  = product?.meta_data?.find((m: any) => m.key === 'rank_math_description')?.value || '';

const productCleanDesc = (product?.short_description || product?.description || "")
    .replace(/<[^>]+>/g, "").trim();

// Detectar tipo de producto por categorías para no poner "Cuero" en ropa o accesorios
const productCatIds = product?.categories?.map((c: any) => c.id) || [];
const isShoe      = productCatIds.some((id: number) => [63, 194, 192, 195, 193, 196, 70].includes(id));
const isClothing  = productCatIds.some((id: number) => [249, 951, 952, 251, 1022, 250].includes(id));
const isAccessory = productCatIds.some((id: number) => [126, 172, 190].includes(id));

const seoSuffix = isShoe
    ? 'Zapatos Cuero Hombre Colombia | Envío Gratis | Winston & Harry'
    : isClothing
        ? 'Ropa Hombre Colombia | Hecho a Mano | Envío Gratis | Winston & Harry'
        : isAccessory
            ? 'Accesorios Cuero Hombre Colombia | Envío Gratis | Winston & Harry'
            : 'Hombre Colombia | Hecho a Mano | Envío Gratis | Winston & Harry';

const seoFallbackTitle = `${product?.name} | ${seoSuffix}`;
const seoFallbackDesc = productCleanDesc
    ? `${productCleanDesc.slice(0, 130)}. Envío gratis a todo Colombia.`
    : `${product?.name} en Winston & Harry. Diseño atemporal, garantía de por vida. Envío gratis a todo Colombia.`;

// Cadena de prioridad: RankMath → Yoast → short/long description de WC → fallback genérico
const seoData = {
    title: rankMathTitle || product?.yoast_head_json?.title || seoFallbackTitle,
    description: rankMathDesc || product?.yoast_head_json?.description || seoFallbackDesc,
    opengraph_title: rankMathTitle || product?.yoast_head_json?.og_title || seoFallbackTitle,
    opengraph_description: rankMathDesc || product?.yoast_head_json?.og_description || seoFallbackDesc,
    opengraph_image: product?.yoast_head_json?.og_image || product?.images?.[0]?.src || null,
    opengraph_type: "website"
};

Astro.response.headers.set('Cache-Control', 'public, s-maxage=86400, stale-while-revalidate=43200');

// Strip para las tarjetas (ProductCard) de productos relacionados y FBT
const stripCardProduct = (p: any) => {
    if (!p) return null;
    return {
        id: p.id,
        name: p.name,
        slug: p.slug,
        type: p.type,
        prices: p.prices,
        price: p.price,
        regular_price: p.regular_price,
        sale_price: p.sale_price,
        on_sale: p.on_sale,
        featured: p.featured,
        stock_status: p.stock_status,
        images: p.images?.map((img: any) => ({ src: img.src, alt: img.alt })), 
        attributes: p.attributes,
        variations: p.variations,
        variation_images_map: p.variation_images_map,
    };
};

// Strip para el producto principal abierto
const stripMainProduct = (p: any) => {
    if (!p) return null;
    return {
        id: p.id,
        name: p.name,
        slug: p.slug,
        description: p.description,
        short_description: p.short_description,
        price: p.price,
        regular_price: p.regular_price,
        sale_price: p.sale_price,
        on_sale: p.on_sale,
        images: p.images,
        categories: p.categories,
        attributes: p.attributes,
        variations: p.variations,
        variation_images_map: p.variation_images_map,
        stock_status: p.stock_status,
        manage_stock: p.manage_stock,
        stock_quantity: p.stock_quantity,
        prices: p.prices,
        type: p.type,
        related_products: p.related_products?.map(stripCardProduct),
        fbt_products: p.fbt_products?.map(stripCardProduct),
        related_ids: p.related_ids
    };
};

const clientProduct = product ? stripMainProduct(product) : null;

const schemaPrice = 
  product?.prices?.price
    ? parseFloat(product.prices.price) / (10 ** (product.prices?.currency_minor_unit || 0))
    : parseFloat(product?.price || product?.regular_price || '0');

const schemaData = (product && schemaPrice > 0 && !isNaN(schemaPrice))
  ? {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": product.name,
      "description": (product.short_description || product.description || "")
        .replace(/<[^>]+>/g, "").trim(),
      "image": product.images?.[0]?.src,
      "sku": product.sku || product.id?.toString(),
      "brand": { "@type": "Brand", "name": "Winston & Harry" },
      ...(product.rating_count > 0 && {
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": product.average_rating,
          "reviewCount": product.rating_count
        }
      }),
      "offers": {
        "@type": "Offer",
        "price": schemaPrice,
        "priceCurrency": "COP",
        "priceValidUntil": new Date(
          new Date().setFullYear(new Date().getFullYear() + 1)
        ).toISOString().split('T')[0],
        "availability": product.stock_status === "instock"
          ? "https://schema.org/InStock"
          : "https://schema.org/OutOfStock",
        "url": `https://www.winstonandharrystore.com/productos/${product.slug}`,
        "hasMerchantReturnPolicy": {
          "@type": "MerchantReturnPolicy",
          "applicableCountry": "CO",
          "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
          "merchantReturnDays": 30,
          "returnMethod": "https://schema.org/ReturnByMail"
        },
        "shippingDetails": {
          "@type": "OfferShippingDetails",
          "shippingRate": {
            "@type": "MonetaryAmount",
            "value": "0",
            "currency": "COP"
          },
          "shippingDestination": {
            "@type": "DefinedRegion",
            "addressCountry": "CO"
          },
          "deliveryTime": {
            "@type": "ShippingDeliveryTime",
            "businessDays": {
              "@type": "OpeningHoursSpecification",
              "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"]
            },
            "cutoffTime": "17:00:00-05:00",
            "handlingTime": {
              "@type": "QuantitativeValue",
              "minValue": 1,
              "maxValue": 2,
              "unitCode": "DAY"
            },
            "transitTime": {
              "@type": "QuantitativeValue",
              "minValue": 2,
              "maxValue": 5,
              "unitCode": "DAY"
            }
          }
        }
      }
    }
  : null;
---

<Layout 
    title={seoData.title || (product ? `${product.name} | Winston & Harry` : "Producto")}
    seoData={seoData}
>
    <Header />

    <main class="product-page-container">
        {
            product ? (
                <ProductDetail client:load initialProduct={clientProduct} />
            ) : (
                <div class="container error-msg">
                    <h1>{error}</h1>
                    <a href="/tienda" class="btn">
                        Volver a la tienda
                    </a>
                </div>
            )
        }
    </main>

    <Footer />

<style>
    .product-page-container {
        padding-top: 90px;
        min-height: 80vh;
    }
    .error-msg {
        text-align: center;
        padding: 10rem 0;
    }
    h1 {
        margin-bottom: 2rem;
        color: var(--color-green);
    }

    @media (max-width: 768px) {
        .product-page-container {
            padding-top: 65px; /* Espacio para el header fixed */
            min-height: 80vh;
        }
</style>

{product && (
  <script
    is:inline
    set:html={`
      window.addEventListener('load', function () {
        if (typeof window !== 'undefined') {
          // GA4
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ ecommerce: null }); 
          window.dataLayer.push({
            event: 'view_item',
            ecommerce: {
              currency: 'COP',
              value: ${schemaPrice},
              items: [{ item_id: "${product.id}", item_name: ${JSON.stringify(product.name)}, price: ${schemaPrice}, quantity: 1 }]
            }
          });
          console.log("✅ GTM TRACKING EXITOSO: view_item");

          // Meta Pixel
          if (typeof window.trackMetaEvent === 'function') {
            window.trackMetaEvent('ViewContent', {
              content_ids: ['${product.id}'],
              content_type: 'product',
              value: ${schemaPrice},
              currency: 'COP'
            });
            console.log("✅ META TRACKING EXITOSO: ViewContent");
          } else if (typeof window.fbq === 'function') {
            // Fallback si no ha cargado
            window.fbq('track', 'ViewContent', {
              content_ids: ['${product.id}'],
              content_type: 'product',
              value: ${schemaPrice},
              currency: 'COP'
            });
          }
        }
      });
    `}
  />
)}

{schemaData && (
  <script type="application/ld+json" is:inline 
    set:html={JSON.stringify(schemaData)} 
  />
)}

</Layout>