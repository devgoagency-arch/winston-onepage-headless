---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import {
    getAllProducts,
    getCategoryTree,
    PUBLIC_WP_URL
} from "../lib/woocommerce";
import FilteredProductList from "../components/FilteredProductList";
import { isOnSale, isInStock, getProductPrice, getProductRegularPrice } from "../lib/productFilters";
import fs from "node:fs";
import path from "node:path";

// Pre-generar los archivos JSON del catálogo de ofertas durante el build-time (SSG)
const catalogDir = path.join(process.cwd(), "public", "data", "catalog");
if (!fs.existsSync(catalogDir)) {
    fs.mkdirSync(catalogDir, { recursive: true });
}

console.log("[SSG Sale] Iniciando pre-generación de catálogos estáticos para SALE...");

let page = 1;
let hasMore = true;
let products: any[] = [];
let allSaleProducts: any[] = [];

// Acumulador para extraer todas las categorías que tengan productos en SALE
const seenCategories = new Map<number, { id: number, name: string, slug: string }>();

// IMPORTANTE: NO usamos on_sale=true de WooCommerce. Ese filtro omite productos variables
// cuyas variaciones están en oferta pero el padre no está marcado. Descargamos TODO el
// catálogo publicado y filtramos aquí con isOnSale() (revisa producto y variaciones).
// Tampoco se reutiliza caché de disco: congelaba listas viejas de ofertas.
while (hasMore) {
    try {
        console.log(`[SSG Sale] Descargando catálogo - página ${page}`);
        const rawPage = await getAllProducts(50, page, "menu_order", "asc", false);
        // Solo ofertas reales y con stock: lo agotado en todos sus colores no se muestra.
        // Es automático: cuando se carga inventario, el siguiente build lo vuelve a incluir.
        const pageProducts = Array.isArray(rawPage) ? rawPage.filter((p: any) => isOnSale(p) && isInStock(p)) : [];

        allSaleProducts = allSaleProducts.concat(pageProducts);

        // Acumulamos las categorías de todos los productos en sale
        pageProducts.forEach(product => {
            if (Array.isArray(product.categories)) {
                product.categories.forEach((cat: any) => {
                    if (cat && cat.id && cat.name && cat.slug) {
                        seenCategories.set(cat.id, {
                            id: cat.id,
                            name: cat.name,
                            slug: cat.slug
                        });
                    }
                });
            }
        });

        // Fin: la API devolvió una página vacía (la API ya no tiene más productos)
        if (!Array.isArray(rawPage) || rawPage.length === 0) {
            hasMore = false;
        } else {
            page++;
        }

        if (page > 40) break; // Límite de seguridad
        await new Promise((r) => setTimeout(r, 200));
    } catch (err: any) {
        console.error(`[SSG Sale] Error pre-generando página ${page}:`, err.message);
        hasMore = false;
    }
}

// Los primeros 16 productos en oferta se renderizan en el HTML inicial
products = allSaleProducts.slice(0, 16);

// Las 12 ofertas con mayor descuento para la sección SALE del home (src/components/SaleHome.tsx).
// Se ordena por % de descuento real (desempate: el orden del catálogo) y se descartan las que no tengan descuento.
const discountRatio = (p: any) => {
    const regular = getProductRegularPrice(p);
    const price = getProductPrice(p);
    return regular > 0 && price > 0 ? (regular - price) / regular : 0;
};
// Para que la fila tenga variedad, se admiten máximo 2 productos del mismo tipo (primera palabra del
// nombre: "Billetera", "Collar"...). Si así no se llegan a 12, se completa con los que quedaron fuera.
const rankedSale = allSaleProducts
    .map((p, index) => ({ p, index, d: discountRatio(p) }))
    .filter((x) => x.d > 0)
    .sort((a, b) => b.d - a.d || a.index - b.index);
const typeCount = new Map<string, number>();
const diverse: any[] = [];
const leftovers: any[] = [];
for (const x of rankedSale) {
    const type = String(x.p.name || "").trim().split(/\s+/)[0].toLowerCase();
    const n = typeCount.get(type) || 0;
    if (n < 2) {
        typeCount.set(type, n + 1);
        diverse.push(x);
    } else {
        leftovers.push(x);
    }
}
const saleHomeProducts = [...diverse, ...leftovers]
    .slice(0, 12)
    .sort((a, b) => b.d - a.d || a.index - b.index)
    .map((x) => x.p);

// Guardar los archivos que usa el cliente de React: el unificado (paginar y filtrar) y el del home
const catalogFiles: Record<string, string> = {
    "sale-all.json": JSON.stringify(allSaleProducts),
    "sale-home.json": JSON.stringify(saleHomeProducts),
};
for (const [fileName, json] of Object.entries(catalogFiles)) {
    fs.writeFileSync(path.join(catalogDir, fileName), json, "utf-8");
}

// INYECCIÓN PARA PRODUCCIÓN: Astro copia `public` antes de renderizar, así que lo escrito arriba
// NO llega a Vercel (sale-all.json daba 404 y la página se quedaba en los primeros 16 productos).
// Se escribe también en la carpeta de salida, igual que hace categoria/[slug].astro.
if (!import.meta.env.DEV) {
    for (const baseDir of ["dist", "dist/client", ".vercel/output/static"]) {
        const base = path.join(process.cwd(), ...baseDir.split("/"));
        if (!fs.existsSync(base)) continue;
        const outCatalogDir = path.join(base, "data", "catalog");
        fs.mkdirSync(outCatalogDir, { recursive: true });
        for (const [fileName, json] of Object.entries(catalogFiles)) {
            fs.writeFileSync(path.join(outCatalogDir, fileName), json, "utf-8");
        }
    }
}

console.log(`[SSG Sale] ✓ Catálogos estáticos de SALE pre-generados exitosamente. Total productos: ${allSaleProducts.length}`);

// Slugs de categorías que no deben mostrarse en los filtros
const IGNORED_CATEGORY_SLUGS = [
    'sin-categorizar',
    'uncategorized',
    'menos-de-350000',
    'menos-de-499000',
    'mas-de-500000',
    'menos-de-200000',
    'tallas-grandes-zapatos-hombre',
    'destacado'
];

// Procesamos las categorías únicas encontradas para alimentar el filtro lateral y el dropdown
const subcategories = Array.from(seenCategories.values())
    .filter(cat => {
        const slug = cat.slug.toLowerCase();
        if (IGNORED_CATEGORY_SLUGS.includes(slug)) return false;
        if (slug.includes('menos-de-') || slug.includes('mas-de-')) return false;
        if (slug === 'sale' || slug === 'ofertas') return false;
        return true;
    })
    .sort((a, b) => a.name.localeCompare(b.name));

const category = {
    id: "all",
    slug: "sale",
    name: "Sale",
    description: "Aprovecha precios especiales en nuestras últimas piezas. La misma calidad de cuero artesanal de Winston & Harry a un precio de oportunidad."
};
const navigationTree = await getCategoryTree();

const activeSort = {
    key: "descuentos",
    label: "Descuentos",
    orderBy: "menu_order",
    order: "asc",
    onSale: true,
};

const desktopBanner = "https://tienda.winstonandharrystore.com/wp-content/uploads/winston-and-harry-outlet-m.jpg";
const mobileBanner = desktopBanner;

const categoryTitle = "SALE";
const categoryDesc = "Aprovecha precios especiales en nuestras últimas piezas. La misma calidad de cuero artesanal de Winston & Harry a un precio de oportunidad.";

// Header de depuración para verificar el tiempo de generación en Vercel
Astro.response.headers.set('X-Generated-At', new Date().toISOString());
Astro.response.headers.set('Cache-Control', 'public, s-maxage=86400, stale-while-revalidate=43200');

const seoData = {
    title: "Sale | Winston & Harry",
    description: categoryDesc,
    opengraph_title: "Sale | Winston & Harry",
    opengraph_description: categoryDesc,
    opengraph_image: desktopBanner,
    opengraph_type: "website"
};
---

<Layout 
    title="Sale | Winston & Harry"
    seoData={seoData}
>
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@graph": [
            {
                "@type": "CollectionPage",
                "@id": "https://www.winstonandharrystore.com/sale#webpage",
                "url": "https://www.winstonandharrystore.com/sale",
                "name": "Sale | Winston & Harry",
                "description": categoryDesc,
                "isPartOf": { "@type": "WebSite", "name": "Winston & Harry", "url": "https://www.winstonandharrystore.com" },
                "inLanguage": "es-CO"
            },
            {
                "@type": "BreadcrumbList",
                "itemListElement": [
                    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://www.winstonandharrystore.com/" },
                    { "@type": "ListItem", "position": 2, "name": "Sale", "item": "https://www.winstonandharrystore.com/sale" }
                ]
            }
        ]
    })} />

    <Header />

    <!-- Breadcrumbs -->
    <div class="breadcrumbs-container">
        <div class="breadcrumbs">
            <a href="/">Inicio</a>
            <span class="separator">/</span>
            <span class="current">Colección Sale</span>
        </div>
    </div>

    <main class="category-page">
        <section
            class="category-banner"
            style={`--desktop-banner: url('${desktopBanner}'); --mobile-banner: url('${mobileBanner}');`}
        >
            <div class="banner-overlay"></div>
            <div class="banner-content">
                <h1 style="color:#fff">{categoryTitle}</h1>
                <p set:html={categoryDesc} />
            </div>
        </section>

        <!-- Componente React de Filtros y Productos -->
        <FilteredProductList
            client:load
            initialProducts={products}
            category={category}
            subcategories={subcategories}
            colorTerms={[]}
            tallaTerms={[]}
            initialSort={activeSort}
            navigationTree={navigationTree}
        />
    </main>

    <Footer />
</Layout>

<style is:global>
    .category-page {
        min-height: 80vh;
        background-color: #fff;
    }

    /* Breadcrumbs */
    .breadcrumbs-container {
        max-width: var(--container-max-width);
        margin: 0 auto;
        padding: 2rem 2rem 1.5rem; /* Ajustado para el header fixed */
    }

    .breadcrumbs {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        font-family: var(--font-paragraphs);
        font-size: 0.75rem;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .breadcrumbs a {
        color: #888;
        text-decoration: none;
        transition: color 0.2s;
    }

    .breadcrumbs a:hover {
        color: var(--color-green);
    }

    .breadcrumbs .current {
        color: #333;
        font-weight: 600;
    }

    .category-banner {
        position: relative;
        height: 800px;
        background-color: var(--color-green);
        background-image: var(--desktop-banner);
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        display: flex;
        align-items: center;
        overflow: hidden;
    }

    @media (max-width: 768px) {
        .category-banner {
            background-image: var(--mobile-banner);
            height: 400px;
        }
    }

    .banner-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.25);
        z-index: 1;
    }

    .banner-content {
        position: relative;
        z-index: 2;
        padding-left: 8%;
        color: #fff;
        max-width: 80%;
    }

    .banner-content h1 {
        font-family: var(--font-titles);
        font-size: 1.25rem;
        margin-bottom: 1rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        max-width: 600px;
        color: #fff !important;
    }

    .banner-content p {
        font-family: var(--font-paragraphs);
        font-size: 0.8rem;
        line-height: 1.6;
        max-width: 500px;
        opacity: 0.9;
        color: #fff !important;
    }
</style>
