---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import HeroPromo from "../components/HeroPromo.astro";
import ScrollRevealBanner from "../components/ScrollRevealBanner.astro";
import ProductGrid from "../components/ProductGrid";
import About from "../components/About.astro";
import Footer from "../components/Footer.astro";
import FeaturesBanner from "../components/FeaturesBanner.astro";
import LookOfTheWeek from "../components/LookOfTheWeek.astro";
import CategoryGrid from "../components/CategoryGrid.astro";
import BlogHome from "../components/BlogHome.astro";
import { getHomePageData, getProductsByCategory } from "../lib/woocommerce";
import { getHeroSlides } from "../lib/hero";
import { getLookOfTheWeekData } from "../lib/look";

// Pre-cargar todos los datos de la página del Home en una única petición (ID 83750)
const homePage = await getHomePageData();
const homeSeo = homePage?.yoast_head_json || homePage?.rank_math_seo || null;

// Extraer el video mp4 de fondo de WordPress (si existe)
const aboutVideoUrl = homePage?.acf?.video_mp4_fondo || homePage?.acf?.about_video_url || "https://tienda.winstonandharrystore.com/wp-content/uploads/WINSTON-HARRY-STORE.mp4";

// Pre-cargar las 3 categorías principales para evitar peticiones del lado del cliente
const productsZapatos = await getProductsByCategory("63", 24, 1, "menu_order", "asc");
const productsRopa = await getProductsByCategory("249", 24, 1, "menu_order", "asc");
const productsMaletas = await getProductsByCategory("190", 24, 1, "menu_order", "asc");

const initialCache = {
	'63': productsZapatos,
	'249': productsRopa,
	'190': productsMaletas
};

// Pre-cargar el Hero Banner CPT en build-time
const heroResult = await getHeroSlides();
const heroSlides = heroResult.slides || [];
const heroSlots = heroResult.slots || 1;

// Pre-cargar el Look of the Week en build-time
const lookData = await getLookOfTheWeekData();
---

<Layout title={homeSeo?.title} seoData={homeSeo}>
	<Header />

	<main>
		<!-- Banner promocional temporal: Look Completo -->
		<HeroPromo />
		
		<!-- Banner original guardado en borrador -->
		<!-- <Hero slides={heroSlides} slots={heroSlots} /> -->

		<div class="content-wrapper">
			<FeaturesBanner />
			<CategoryGrid />
			<ProductGrid client:load initialProducts={productsZapatos} initialCache={initialCache} />
			<ScrollRevealBanner
				imageUrl="/images/banner-look-completo.webp"
				title="Estilo que se construye con intención"
				description="Cada prenda está pensada para integrarse a tu forma de vestir y a tu ritmo. Descubre ropa que suma, combina y se adapta a tu día. chaquetas, camisas y suéteres."
				pretitle="Winston & Harry"
			/>
			<LookOfTheWeek initialData={lookData} />
			<About videoUrl={aboutVideoUrl} />
		</div>
	</main>

	<Footer />

	<script type="application/ld+json" is:inline set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "Organization",
		"name": "Winston & Harry",
		"url": "https://www.winstonandharrystore.com",
		"logo": "https://www.winstonandharrystore.com/images/logo.png",
		"description": "Marca colombiana de ropa y accesorios de cuero para hombre, hechos a mano por artesanos colombianos.",
		"foundingLocation": {
			"@type": "Place",
			"name": "Colombia"
		},
		"sameAs": [
			"https://www.instagram.com/winstonandharrystore/",
			"https://www.tiktok.com/@winstonandharrystore",
			"https://www.facebook.com/winstonandharrystore"
		]
	})} />
</Layout>

<style is:global>
	/* Smoothie scroll */
	html {
		scroll-behavior: smooth;
	}

	main {
		/* Eliminamos overflow-x para permitir que position: sticky funcione en los componentes hijos */
	}

	.content-wrapper {
		position: relative;
		z-index: 10;
		background-color: var(--color-white);
	}
</style>
