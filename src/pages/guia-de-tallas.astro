---
import LegalLayout from "../layouts/LegalLayout.astro";
import { getSnapshotPageById } from "../lib/snapshot";

const page = getSnapshotPageById(14662);

let title = "GUÍA DE TALLAS";
let subtitle = "";
let content = "";

if (page) {
    title = page.title?.rendered || title;
    const rawContent = page.content?.rendered || "";

    if (rawContent.includes('</p>')) {
        const parts = rawContent.split(/<\/p>/);
        subtitle = parts[0].replace(/<p[^>]*>/g, "").trim();
        content = parts.slice(1).join("</p>");
    } else {
        content = rawContent;
    }
} else {
    content = "<p>Lo sentimos, no pudimos cargar el contenido de la guía de tallas en este momento. Por favor, intenta más tarde.</p>";
}
---

<LegalLayout 
    title={title} 
    subtitle={subtitle}
    description="Aprende a medir tu pie y encuentra tu talla perfecta en zapatos Winston & Harry. Incluye tabla comparativa Colombia, US, UK y Europa."
>
    <div class="wp-content" set:html={content} />
</LegalLayout>

<style is:global>
    /* Ajustes específicos para las tablas de tallas si vienen de WordPress */
    .wp-content table {
        width: 100%;
        border-collapse: collapse;
        margin: 2rem 0;
        font-family: var(--font-paragraphs);
        font-size: 0.85rem;
    }

    .wp-content table th {
        background-color: var(--color-green);
        color: white;
        padding: 1rem;
        text-align: left;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .wp-content table td {
        padding: 1rem;
        border-bottom: 1px solid #eee;
        color: #555;
    }

    .wp-content table tr:hover td {
        background-color: #f9f9f9;
        color: var(--color-green);
    }
</style>
