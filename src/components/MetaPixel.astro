// MetaPixel.astro
---

<!-- Meta Pixel Code — diferido 2.5s después de load para no bloquear LCP -->
<script is:inline>
window.addEventListener('load', function() {
  setTimeout(function() {
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    if (!window._fbqInitialized) {
      window._fbqInitialized = true;
      fbq('init', '533909598411848');
      fbq('track', 'PageView');
    }
  }, 2500);
});
</script>
<noscript><img height="1" width="1" style="display:none"
src="https://www.facebook.com/tr?id=533909598411848&ev=PageView&noscript=1"
/></noscript>
<!-- End Meta Pixel Code -->

<!-- PageView Track + Astro ViewTransitions -->
<script>
    import { trackMetaEvent } from '../utils/metaPixel';

    // Hacerlo global para scripts inline (ej. ViewContent en [slug].astro)
    (window as any).trackMetaEvent = trackMetaEvent;

    // Disparar en cada vista de página (Astro ViewTransitions garantiza que astro:page-load
    // se dispara tanto en la primera carga completa como en las navegaciones SPA subsiguientes)
    document.addEventListener('astro:page-load', () => {
        trackMetaEvent('PageView');
    });
</script>
