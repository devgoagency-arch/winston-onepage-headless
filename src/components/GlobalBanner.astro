---
import { CAMPANA_BLACK_DAYS } from '../config/campaign';
import { isBlackDaysActive, isBlackDaysPreviewBuild } from '../lib/blackDays';
interface Props { clockOnly?: boolean }
const { clockOnly = false } = Astro.props;
const start = Date.parse(CAMPANA_BLACK_DAYS.fecha_inicio);
const end = Date.parse(CAMPANA_BLACK_DAYS.fecha_fin) + 1000;
const enabled = CAMPANA_BLACK_DAYS.activa;
const dev = import.meta.env.DEV;
const preview = isBlackDaysPreviewBuild();
const activeAtBuild = dev || (preview ? Astro.url.pathname.startsWith('/black-days') : enabled && isBlackDaysActive());
---
{clockOnly ? (
    <script is:inline define:vars={{ start, end, enabled, dev, preview }}>
        // Ejecutado en head antes del primer pintado: sin salto por hidratación.
        (() => {
            let timer;
            const isActive = pathname => dev || (preview ? pathname.startsWith('/black-days') : enabled && Date.now() >= start && Date.now() < end);
            const sync = () => {
                clearTimeout(timer);
                const now = Date.now();
                document.documentElement.classList.toggle('black-days-active', isActive(location.pathname));
                const boundary = [start, end].find(t => t > now);
                if (!preview && !dev && boundary) timer = setTimeout(sync, Math.min(boundary - now, 2147483647));
            };
            sync();
            window.addEventListener('focus', sync);
            document.addEventListener('visibilitychange', sync);
            document.addEventListener('astro:page-load', sync);
            // Preparar el documento entrante antes del swap evita un frame con otra altura.
            document.addEventListener('astro:before-swap', event => {
                event.newDocument.documentElement.classList.toggle('black-days-active', isActive(event.to.pathname));
            });
        })();
    </script>
) : (
    <div class="cintillo-global" data-active-at-build={activeAtBuild}>
        <span class="desktop-only">🖤 Black Days · hasta 70 % off en zapatos + Arma tu Black · 23 al 30 nov</span>
        <span class="mobile-only">🖤 Black Days · hasta 70 %</span>
        <a href="/black-days?utm_source=cintillo&utm_medium=site&utm_campaign=black-days-2026">Ver Black Days →</a>
    </div>
)}
<style is:global>
    :root { --global-banner-height: 0px; }
    :root.black-days-active { --global-banner-height: 44px; }
    .black-days-active .header { top: var(--global-banner-height, 0px) !important; }
    .black-days-active body { padding-top: var(--global-banner-height, 0px); }
    .cintillo-global { display: none; position: fixed; top: 0; left: 0; width: 100%; height: var(--global-banner-height); z-index: 2000; background: #000; color: #fff; align-items: center; justify-content: center; gap: 20px; font-family: var(--font-paragraphs); font-size: 13px; }
    .black-days-active .cintillo-global { display: flex; }
    .cintillo-global a { color: #D4A853; white-space: nowrap; }
    .cintillo-global .mobile-only { display: none; }
    @media (max-width: 768px) {
        :root.black-days-active { --global-banner-height: 34px; }
        .cintillo-global { gap: 10px; font-size: 11px; }
        .cintillo-global .desktop-only { display: none; }
        .cintillo-global .mobile-only { display: inline; }
    }
</style>
