---
import { NOVEDADES } from "../../config/experiencia";
---

<section id="novedades" class="exp-seccion">
    <div class="container">
        <div class="exp-cabecera">
            <h2>Siempre hay algo nuevo por descubrir.</h2>
            <p>Conoce nuestras colecciones, lanzamientos y contenidos.</p>
            <p id="exp-novedades-invitacion" class="exp-novedades__nota">
                ¿Quieres recibirlos en tu correo? <a href="#suscribete">Suscríbete</a>.
            </p>
        </div>
        <nav class="exp-novedades" aria-label="Colecciones">
            {
                NOVEDADES.map((n) => (
                    <a href={n.href} class="exp-novedad reveal-on-scroll">
                        <span class="exp-novedad__foto">
                            <img src={n.imagen} alt="" width="342" height="425" loading="lazy" decoding="async" />
                        </span>
                        <span class="exp-novedad__nombre">{n.nombre}</span>
                    </a>
                ))
            }
        </nav>
    </div>
</section>

<style>
    .exp-novedades__nota {
        margin-top: 0.5rem;
        font-size: 0.85rem;
    }

    .exp-novedades__nota a {
        color: var(--color-green);
        text-decoration: underline;
    }

    .exp-novedades {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.75rem;
        max-width: 1050px;
        margin: 0 auto;
    }

    .exp-novedad__foto {
        display: block;
        aspect-ratio: 3 / 4;
        margin-bottom: 1rem;
        overflow: hidden;
        background: #f5f5f5;
    }

    .exp-novedad__foto img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s ease;
    }

    .exp-novedad:hover img {
        transform: scale(1.05);
    }

    .exp-novedad__nombre {
        display: block;
        color: var(--color-green);
        font-family: var(--font-titles);
        font-size: 1.1rem;
        text-align: center;
    }

    @media (min-width: 769px) {
        .exp-novedades {
            gap: 2rem;
        }

        .exp-novedad__nombre {
            font-size: 1.35rem;
        }
    }
</style>
