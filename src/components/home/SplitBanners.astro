---
// src/components/home/SplitBanners.astro
// Dos paneles a mitad de ancho. Imágenes desde WP/CDN.
// Fade-in al scroll via RevealOnView (IntersectionObserver, sin librerías).
// Desktop: lado a lado. Mobile: apilados.

import RevealOnView from '../ui/RevealOnView.astro';

interface Panel {
  image:     string;
  title:     string;
  subtitle?: string;
  cta_label: string;
  cta_href:  string;
}

interface Props {
  left:  Panel;
  right: Panel;
}

const { left, right } = Astro.props;
const panels = [left, right];
---

<section class="sp" aria-label="Explora por categoría">
  {panels.map((panel, i) => (
    <RevealOnView delayMs={i * 120}>
      <a href={panel.cta_href} class="sp__panel">
        <img
          src={panel.image}
          alt={panel.title}
          class="sp__img"
          loading="lazy"
          decoding="async"
        />
        <div class="sp__overlay">
          <h2 class="sp__title">{panel.title}</h2>
          {panel.subtitle && <p class="sp__subtitle">{panel.subtitle}</p>}
          <span class="sp__cta">{panel.cta_label} →</span>
        </div>
      </a>
    </RevealOnView>
  ))}
</section>

<style>
  .sp {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3px;               /* 3px entre paneles izq/der */
    background: #fff;       /* gap blanco */
    margin: 3px 0 0;        /* 3px separación con el hero */
    padding: 0;
    line-height: 0;
  }

  @media (max-width: 768px) {
    .sp { grid-template-columns: 1fr; }
  }

  /* RevealOnView envuelve el <a>, necesita ser bloque */
  .sp :global(.reveal) {
    display: block;
  }

  .sp__panel {
    position: relative;
    display: block;
    /* 4/5 en mobile, 3/4 en desktop */
    aspect-ratio: 4 / 5;
    max-height: 90vh;
    overflow: hidden;
    text-decoration: none;
    color: #fff;
  }

  @media (min-width: 769px) {
    .sp__panel {
      aspect-ratio: 960 / 1080;
      max-height: 100vh;
    }
  }

  .sp__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.65s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .sp__panel:hover .sp__img {
    transform: scale(1.05);
  }

  .sp__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    background: linear-gradient(
      0deg,
      rgba(10, 10, 10, 0.72) 0%,
      rgba(10, 10, 10, 0)    55%
    );
  }

  /* Title: -25% + blanco */
  .sp__title {
    font-family: var(--font-titles, 'Antonio', sans-serif);
    font-size: clamp(0.975rem, 1.875vw, 1.425rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin: 0 0 0.4rem;
    line-height: 1.1;
    color: #fff;
  }

  .sp__subtitle {
    font-family: var(--font-paragraphs, sans-serif);
    font-size: 0.88rem;
    color: #fff;
    opacity: 0.85;
    margin: 0 0 0.9rem;
    line-height: 1.5;
  }

  .sp__cta {
    font-family: var(--font-paragraphs, sans-serif);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-bottom: 1px solid rgba(255, 255, 255, 0.55);
    width: fit-content;
    padding-bottom: 5px;
    color: #fff;
    transition: border-color 0.25s ease, opacity 0.25s ease;
  }

  .sp__panel:hover .sp__cta {
    border-color: #fff;
    opacity: 1;
  }
</style>
